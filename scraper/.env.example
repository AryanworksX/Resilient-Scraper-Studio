# From Bright Data: Dashboard -> Account settings -> API key
BRIGHTDATA_API_TOKEN=your-brightdata-api-token

# From `bdata scraper create <url> "<fields to extract>"` — looks like c_xxxxxxxxxx
BRIGHTDATA_COLLECTOR_ID=c_xxxxxxxxxx

# Your Flask backend (local: http://localhost:5000, prod: your Vercel backend URL)
SCRAPER_STUDIO_API_URL=http://localhost:5000
