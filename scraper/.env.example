# From `bdata scraper create <url> "<fields to extract>"` — looks like c_xxxxxxxxxx
BRIGHTDATA_COLLECTOR_ID=c_xxxxxxxxxx

# Your Flask backend (local: http://localhost:5000, prod: your Vercel backend URL)
SCRAPER_STUDIO_API_URL=http://localhost:5000

# Which LLM to use in llm_picker.py: "anthropic" or "nvidia". Only fill in
# the API key for whichever one you pick.
LLM_PROVIDER=anthropic

# Get this from console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Get this free at build.nvidia.com -> API Keys (no card required).
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional. If set, llm_picker.py drops any scraped row that isn't about
# this category. Leave blank to keep every row and only normalize fields.
TARGET_CATEGORY=
